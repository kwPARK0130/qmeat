# Export variables in your shell or run uvicorn with an explicitly configured env loader.
QMEAT_DB=data/qmeat.sqlite3
QMEAT_WORKER=1
# Server-only API keys: enter securely; never commit real values.
# CUSTOMS_API_KEY=
# EXIM_API_KEY=
# Official API documents and live responses must be verified before enabling adapters.
QMEAT_ENABLE_UNVERIFIED_API=0
# Without this setting the app is a single-organization LOCAL workspace.
# Before exposing over a network, set users and terminate HTTPS at a trusted reverse proxy.
# QMEAT_USERS={"user":{"password":"replace-with-strong-password","org":"organization-id"}}
